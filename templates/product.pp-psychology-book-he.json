        "e21dac96-0ca3-4460-ab4a-667e9251f332": {
          "type": "column_with_icon",
          "settings": {
            "icon": "none",
            "icon_size": 64,
            "title": "Learn how habits form and stick",
            "text": "<p>Learn the psychological foundations of habit formation and sustained engagement so you can design products that fit naturally into users’ routines. </p><p></p>",
