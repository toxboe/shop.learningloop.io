            "link_url": ""
          }
        },
        "column_with_icon_KnJaeb": {
          "type": "column_with_icon",
          "settings": {
            "icon": "none",
            "icon_size": 64,
            "title": "",
            "text": "<p><strong>“I already know UX.”</strong><br/>This book is designed to build on the UX tools and frameworks you already use, while deepening your understanding of user behavior through psychology. </p><p><strong>“I do not want manipulative engagement tactics.”</strong><br/>Good. The book emphasizes ethical design, respect for autonomy, user well-being, transparency, and long-term trust.</p><p><strong>“I need practical guidance, not theory alone.”</strong><br/>The book is practical  and actionable, with guidance you can implement in products. </p><p><strong>“I care about retention, not just engagement vanity metrics.”</strong><br/>That is exactly the angle here: onboarding, activation, retention, long-term relationships, and meaningful repeated use.</p>",
            "link_text": "",
            "link_url": ""
          }
        }
      },
