          "type": "column_with_icon",
          "settings": {
            "icon": "none",
            "icon_size": 64,
            "title": "Solve problems with psychology",
            "text": "<p>Getting a user to sign up is one challenge.</p><p>Getting them to come back tomorrow, next week, and next month is another.</p>",
            "link_text": "",
            "link_url": ""
          }
        }
      },
      "block_order": [
