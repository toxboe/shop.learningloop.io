    "multicolumn_pPekeA": {
      "type": "multicolumn",
      "blocks": {
        "column_with_icon_ANRezM": {
          "type": "column_with_icon",
          "settings": {
            "icon": "none",
            "icon_size": 64,
            "title": "This book is for you even if…",
