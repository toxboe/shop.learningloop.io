    "multicolumn_ymwWGd": {
      "type": "multicolumn",
      "blocks": {
        "column_with_icon_yGtUPH": {
          "type": "column_with_icon",
          "settings": {
            "icon": "none",
            "icon_size": 64,
            "title": "",
            "text": "<p>Inside, you will learn how to:</p><ul><li>design for habit formation</li><li>strengthen onboarding and activation</li><li>improve retention and repeat use</li><li>create motivating product experiences</li><li>build stronger long-term relationships with users</li><li>apply persuasive psychology ethically</li></ul>",
            "link_text": "",
            "link_url": ""
          }
        },
        "column_with_icon_KqWybf": {
          "type": "column_with_icon",
          "settings": {
            "icon": "none",
            "icon_size": 64,
            "title": "",
            "text": "<p>The book is created as a bridge between psychological theory and practical product design, with the goal of helping designers create products users love and return to. </p>",
            "link_text": "",
            "link_url": ""
          }
        }
      },
      "block_order": [
        "column_with_icon_yGtUPH",
        "column_with_icon_KqWybf"
