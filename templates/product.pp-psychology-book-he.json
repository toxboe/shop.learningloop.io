        "container_size": "medium",
        "section_spacing_top": 90,
        "section_spacing_bottom": 0,
        "desktop_layout": "grid",
        "mobile_layout": "one-column-grid",
        "title": "Most products get attention.",
        "text": "<strong>Very few build habits.</strong>",
        "heading_size": "h0",
        "body_size": "body0",
        "content_alignment": "center",
        "column_heading_size": "h5",
