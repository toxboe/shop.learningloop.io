          "settings": {
            "icon": "none",
            "icon_size": 64,
            "title": "Create deeper engagement, not surface-level activity",
            "text": "<p>It is designed to move you away from shallow engagement tactics and toward a more profound psychology-informed approach. </p><p></p>",
            "link_text": "",
            "link_url": ""
          }
        },
        "819c0f7b-3c32-4406-86be-243c631766e3": {
